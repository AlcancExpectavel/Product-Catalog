# ============================================================
# CONFIGURAÇÃO FIREBASE
# Copia este ficheiro para ".env.local" e preenche os valores
# Encontras estas chaves em: Firebase Console > Project Settings > General > Your apps
# ============================================================

NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=o-teu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=o-teu-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=o-teu-projeto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# ============================================================
# ADMIN
# Email do administrador que terá acesso ao painel /admin
# ============================================================
NEXT_PUBLIC_ADMIN_EMAIL=admin@tuaempresa.com
